<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource PageBrush}">
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <DockPanel Margin="24,16,24,10">
        <Border DockPanel.Dock="Right" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource HairlineBrush}"
                BorderThickness="1" CornerRadius="10" Padding="3" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="NavNow" Style="{StaticResource NavItem}" GroupName="nav" Content="Agora" IsChecked="True"/>
                <RadioButton x:Name="NavApps" Style="{StaticResource NavItem}" GroupName="nav" Content="Apps"/>
                <RadioButton x:Name="NavHistory" Style="{StaticResource NavItem}" GroupName="nav" Content="Histórico"/>
                <RadioButton x:Name="NavSettings" Style="{StaticResource NavItem}" GroupName="nav" Content="Ajustes"/>
            </StackPanel>
        </Border>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Image x:Name="Logo" Width="28" Height="28" Margin="0,0,11,0" VerticalAlignment="Center"/>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="VolumeGuard" FontSize="16" FontWeight="SemiBold"/>
                <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                    <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="{StaticResource GoodBrush}" VerticalAlignment="Center" Margin="0,1,6,0"/>
                    <TextBlock x:Name="HeaderStatus" Style="{StaticResource Caption}" Text="Iniciando…"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </DockPanel>
    <Grid x:Name="PageHost" Grid.Row="1"/>
</Grid>
