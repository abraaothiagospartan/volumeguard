<Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Margin="18" Width="390">
    <Border x:Name="Card" CornerRadius="14" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource CriticalBrush}" BorderThickness="1.5" Padding="18,16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="3" Opacity="0.55" Color="Black"/>
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="IconBg" Width="40" Height="40" CornerRadius="20" Background="#3A1D1D" VerticalAlignment="Top">
                <TextBlock x:Name="IconText" Text="!" FontSize="22" FontWeight="Bold" Foreground="{StaticResource CriticalBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="1" Margin="14,0,0,0">
                <DockPanel>
                    <Button x:Name="CloseButton" DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="✕" VerticalAlignment="Top" Margin="6,-4,-8,0"/>
                    <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{StaticResource InkBrush}"/>
                </DockPanel>
                <TextBlock x:Name="BodyText" Foreground="{StaticResource InkSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button x:Name="PrimaryButton" Style="{StaticResource DangerButton}" Content="Baixar agora" Foreground="{StaticResource InkBrush}"/>
                    <Button x:Name="SecondaryButton" Content="Ignorar 15 min" Margin="8,0,0,0" Foreground="{StaticResource InkBrush}"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Border>
