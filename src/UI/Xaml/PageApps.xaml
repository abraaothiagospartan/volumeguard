<ScrollViewer xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:vg="clr-namespace:VolumeGuard.UI;assembly=VolumeGuard"
              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="24,6,24,24">
        <DockPanel>
            <Button x:Name="ResetAllButton" DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Content="Voltar todos ao volume padrão" VerticalAlignment="Center"/>
            <TextBlock Text="Apps com áudio agora" Style="{StaticResource H2}" VerticalAlignment="Center"/>
        </DockPanel>
        <TextBlock x:Name="AppsHint" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,12"/>

        <ItemsControl x:Name="AppsList">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="38"/>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="116"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Image Source="{Binding Icon}" Width="24" Height="24" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <vg:MeterBar Height="4" Value="{Binding Meter}" Fill="{Binding MeterBrush}" Margin="2,0,2,3"/>
                                <Slider Minimum="-60" Maximum="0" SmallChange="0.5" LargeChange="3" Value="{Binding VolumeDb, Mode=TwoWay}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="12,0,14,0">
                                <TextBlock Text="{Binding VolumeText}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                <TextBlock Text="{Binding VolumeAltText}" Style="{StaticResource Caption}" HorizontalAlignment="Right"/>
                            </StackPanel>
                            <Border Grid.Column="4" Style="{StaticResource SegmentHost}" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource SegmentSmall}" GroupName="{Binding Group}" IsChecked="{Binding IsAuto, Mode=TwoWay}" Content="Auto" ToolTip="Segue o modo escolhido (volume fixo ou nível alvo)"/>
                                    <RadioButton Style="{StaticResource SegmentSmall}" GroupName="{Binding Group}" IsChecked="{Binding IsFixed, Mode=TwoWay}" Content="Fixo" ToolTip="Sempre abre neste volume, mesmo no modo nível alvo"/>
                                    <RadioButton Style="{StaticResource SegmentSmall}" GroupName="{Binding Group}" IsChecked="{Binding IsIgnore, Mode=TwoWay}" Content="Ignorar" ToolTip="O VolumeGuard não mexe no volume deste app (só mede)"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border x:Name="AppsEmpty" Style="{StaticResource Card}" Padding="18,22" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="Nenhum app com áudio aberto agora" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <TextBlock Style="{StaticResource Muted}" Text="Assim que algum programa ou site tocar som, ele aparece aqui." HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <TextBlock Text="Apps lembrados" Style="{StaticResource H2}" Margin="0,22,0,4"/>
        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12"
                   Text="Volumes e regras guardados para cada programa. Quando ele abrir de novo, já começa assim."/>
        <ItemsControl x:Name="SavedList">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,0,1" Padding="4,9">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Content="Esquecer" Command="{Binding Forget}" VerticalAlignment="Center"/>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Summary}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,0,16,0"/>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock x:Name="SavedEmpty" Style="{StaticResource Caption}" Text="Nada guardado ainda." Visibility="Collapsed"/>
    </StackPanel>
</ScrollViewer>
