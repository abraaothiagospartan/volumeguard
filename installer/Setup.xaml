<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource PageBrush}">
    <Grid Margin="28,24,28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <Image x:Name="Logo" Width="48" Height="48"/>
            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" FontSize="20" FontWeight="SemiBold" Text="Instalar o VolumeGuard"/>
                <TextBlock x:Name="VersionText" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,20,0,16">
            <StackPanel x:Name="InstallPanel">
                <TextBlock TextWrapping="Wrap" Style="{StaticResource Muted}"
                           Text="Deixa cada app abrir no volume que você escolher, barra propagandas estouradas e mostra quantos dB você está ouvindo."/>
                <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="16,12">
                    <StackPanel>
                        <CheckBox x:Name="AutostartCheck" IsChecked="True" Content="Iniciar junto com o Windows (recomendado: é o que mantém a proteção sempre ligada)"/>
                        <CheckBox x:Name="DesktopCheck" Content="Criar atalho na área de trabalho"/>
                        <CheckBox x:Name="LaunchCheck" IsChecked="True" Content="Abrir o VolumeGuard ao terminar"/>
                    </StackPanel>
                </Border>
                <TextBlock x:Name="PathText" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,12,0,0"/>
                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0"
                           Text="Não precisa de administrador. O VolumeGuard funciona offline e não envia nenhum dado."/>
            </StackPanel>

            <StackPanel x:Name="UninstallPanel" Visibility="Collapsed">
                <TextBlock TextWrapping="Wrap" Style="{StaticResource Muted}"
                           Text="O VolumeGuard será fechado e removido deste PC. Os volumes que ele já ajustou nos apps continuam como estão (dá para mudar no mixer do Windows)."/>
                <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="16,12">
                    <CheckBox x:Name="RemoveDataCheck" Content="Apagar também meu histórico de dB e as configurações"/>
                </Border>
            </StackPanel>

            <StackPanel x:Name="ProgressPanel" Visibility="Collapsed" VerticalAlignment="Center">
                <TextBlock x:Name="ProgressText" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock x:Name="DetailText" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CancelButton" Content="Cancelar" MinWidth="96"/>
            <Button x:Name="PrimaryButton" Style="{StaticResource AccentButton}" Content="Instalar" MinWidth="120" Margin="8,0,0,0"/>
        </StackPanel>
    </Grid>
</Grid>
